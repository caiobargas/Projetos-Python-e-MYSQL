CREATE DATABASE "PROJETO_EXPOTECH_VERSAO1";
USE DATABASE "PROJETO_EXPOTECH_VERSAO1";

CREATE TABLE TBL_USUARIOS (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    NOME VARCHAR(100) NOT NULL,
    EMAIL VARCHAR(100) UNIQUE,
    TELEFONE VARCHAR(50) NOT NULL,
    DATA_NASCIMENTO DATE NOT NULL
    USUARIO_ATIVO BOOLEAN NOT NULL
)

CREATE TABLE TBL_CONTATOEMERGENCIA (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    NOME VARCHAR(100) NOT NULL,
    TELEFONE VARCHAR(50) NOT NULL,
    PARENTESCO VARCHAR(100) NOT NULL,
    EMAIL VARCHAR(100) UNIQUE
    CONTATO_ATIVO BOOLEAN NOT NULL
)

CREATE TABLE TBL_TRATAMENTOS (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    NOME VARCHAR(100) NOT NULL,
    TIPO_TRATAMENTO VARCHAR(100) NOT NULL,
    TEMPO_TRATAMENTO VARCHAR(100) NOT NULL,
    DESCRICAO VARCHAR(400) NOT NULL
)

CREATE TABLE TBL_REMEDIOS (
    ID INT AUTO_INCREMENT PRIMARI KEY,
    NOME VARCHAR(100) NOT NULL,
    DOSAGEM VARCHAR(100) NOT NULL,
    FREQUENCIA VARCHAR(100) NOT NULL,
    DESCRICAO VARCHAR(400) NOT NULL,
    TIPO_REMEDIO VARCHAR(100) NOT NULL
)

